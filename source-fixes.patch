   history: createWebHistory(import.meta.env.BASE_URL),
 
+  // Without this, Vue Router keeps the browser's current scroll offset
+  // on every navigation. That's why pages like /orders could open
+  // already scrolled down (to wherever the previous page left off)
+  // instead of showing the top of the list — even though the orders
+  // query itself is already sorted newest-first.
+  scrollBehavior(to, from, savedPosition) {
+    // Respect back/forward browser navigation (restores previous scroll).
+    if (savedPosition) {
+      return savedPosition
+    }
+
+    // Support in-page anchors (e.g. '#section').
+    if (to.hash) {
+      return { el: to.hash, behavior: 'smooth' }
+    }
+
+    // Default: every new navigation starts at the top of the page.
+    return { top: 0 }
+  },
+
   routes: [
     /*
     |--------------------------------------------------------------------------
