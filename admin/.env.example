# Copy to .env — SAME Supabase project as the customer app.
# Get these from: Supabase Dashboard -> Project Settings -> API
# Anon key only. NEVER put the service_role key in this app either —
# admin privilege here comes from the signed-in user's profiles.role
# being 'admin' (checked by RLS), not from a special key.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
